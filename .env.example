# Only this one is required. Set it in Vercel > Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=
# Optional overrides (defaults are in lib/supabase/env.ts; the publishable key is safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=
# Optional: switch the reader model (default claude-opus-5; cheaper: claude-sonnet-5)
PLAN_READER_MODEL=
